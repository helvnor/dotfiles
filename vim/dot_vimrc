
"" CONFIG
set nocompatible
set hidden
set nofixeol
set noswapfile
set undofile
set undodir=~/.vim/undo
if !isdirectory(expand('~/.vim/undo'))
    call mkdir(expand('~/.vim/undo'), 'p')
endif
set mouse=a

"" INDENTATION
set autoindent
set smartindent
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set backspace=indent,eol,start

"" SEARCH
set showmatch
set incsearch
set ignorecase
set smartcase
set hlsearch
" Recursive :find (used by <leader>ff)
set path+=**

"" FOLDING
" Closest plugin-free equivalent of nvim's treesitter expr folding
set foldmethod=syntax
set foldlevelstart=99
set foldnestmax=10

"" UI
set laststatus=2
set nocursorline
set wildmenu
set showcmd
set nowrap
set linebreak
set scrolloff=2
set number
set relativenumber
set conceallevel=2
set belloff=all
syntax enable
set termguicolors
set background=dark
" Built-in stand-in for everforest
colorscheme slate

"" SPELL
set spelllang=en_gb
autocmd FileType markdown,text setlocal spell

"" GENERAL KEYMAPS
let mapleader = " "
nnoremap <F1> <Nop>
nnoremap Q <Nop>

" Window navigation: Ctrl-[h,j,k,l]
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Window arrangement: Leader->[arrow]
nnoremap <leader><Left> <C-w>H
nnoremap <leader><Down> <C-w>J
nnoremap <leader><Up> <C-w>K
nnoremap <leader><Right> <C-w>L

" Window resize: [arrow]
nnoremap <Left> <C-w>3<
nnoremap <Down> <C-w>3+
nnoremap <Up> <C-w>3-
nnoremap <Right> <C-w>3>

" Tab management: Leader->t...
nnoremap <leader>tn :tabnew<CR>
nnoremap <leader>tx :tabclose<CR>
for s:i in range(1, 9)
    execute 'nnoremap <leader>' . s:i . ' :tabnext ' . s:i . '<CR>'
    execute 'nnoremap <leader>t' . s:i . ' :tabnext ' . s:i . '<CR>'
    execute 'nnoremap <leader>tm' . s:i . ' :tabmove ' . s:i . '<CR>'
endfor

" Copy / paste: Leader->c
vnoremap <leader>cy "+y
noremap <leader>cp "+p

" File browser (Oil in nvim): -
nnoremap - :Explore<CR>

" Find (Telescope in nvim): Leader->f
nnoremap <leader>ff :find<Space>
nnoremap <leader>fb :ls<CR>:buffer<Space>
